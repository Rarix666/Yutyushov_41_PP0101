<Window x:Class="AISDisciplineDesc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AISDisciplineDesc"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:materialDesignIcons="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="#4a821f"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Авторизация" 
        Height="500" Width="600" Cursor="">

    <Border Width="300" Height="350"
        Background="White"
        CornerRadius="15"
        Margin="5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Label Grid.Row="1" 
               Content="Авторизация" 
               HorizontalAlignment="Center" 
               FontSize="22" FontWeight="Bold" 
               Margin="0,10,0,10"/>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,5,0,5">
            <Label Content="Логин:" 
                   FontSize="18" 
                   VerticalAlignment="Center" 
                   Margin="10,0,10,0"/>
            <TextBox x:Name="textBox2" 
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                     Width="180" Height="40" 
                     FontSize="18"/>
        </StackPanel>

        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,5,0,5">
            <Label Content="Пароль:" 
                   FontSize="18" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,0"/>
            <Grid Margin="0,0,0,0" Cursor="" Width="180">
                <!-- PasswordBox -->
                <PasswordBox
                x:Name="HiddenPasswordBox"
                materialDesign:PasswordBoxAssist.Password=
                "{Binding Password, Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}">

                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox"
                         BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">

                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordVisible}"
                                    Value="True">
                                    <Setter Property="Visibility"
                                    Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
                <!-- TextBox -->
                <TextBox
                 Text="{Binding Password,
                    UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox"
                        BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">

                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordVisible}"
                         Value="True">
                                    <Setter Property="Visibility"
                        Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Width="53" Height="32" Margin="0,0,-10,0"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0"
                Command="{Binding TogglePasswordVisibilityCommand}">
                    <materialDesign:PackIcon Width="22" Height="22" Foreground="Black">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="Eye"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Kind" Value="EyeOff"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>
            </Grid>
        </StackPanel>

        <Button x:Name="button1" 
                Grid.Row="4" 
                Width="120" Height="35" 
                Content="Войти" 
                HorizontalAlignment="Center" 
                Command="{Binding LoginCommand}"
                Background="#6308bf" FontSize="20"
                Margin="0,10,0,10" Cursor="Hand"/>
    </Grid>
    </Border>
</Window>
