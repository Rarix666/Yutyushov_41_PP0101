<Window x:Class="AISDisciplineDesc.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AISDisciplineDesc"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Личное дело" Height="450" Width="800">

    <Window.Resources>
        <local:StringToImageSourceConverter x:Key="ImageConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: данные -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <Label Content="Личное дело" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовки -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <Label Content="ФИО:" Margin="0,0,0,8"/>
                    <Label Content="Подразделение:" Margin="0,0,0,8"/>
                    <Label Content="Должность:" Margin="0,0,0,8"/>
                    <Label Content="Телефон:" Margin="0,0,0,8"/>
                    <Label Content="Адрес:" Margin="0,0,0,8"/>
                    <Label Content="Почта:" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- Значения -->
                <StackPanel Grid.Column="1">
                    <Label Name="LabelName" Content="{Binding Name}" Margin="0,0,0,8"/>
                    <Label Name="LabelDivision" Content="{Binding Division}" Margin="0,0,0,8"/>
                    <Label Name="LabelRole" Content="{Binding Role}" Margin="0,0,0,8"/>
                    <Label Name="LabelPhone" Content="{Binding Phone}" Margin="0,0,0,8"/>
                    <Label Name="LabelAdress" Content="{Binding Address}" Margin="0,0,0,8"/>
                    <Label Name="LabelEmail" Content="{Binding Email}" Margin="0,0,0,8"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Правая часть: аватар, кнопка смены фото и кнопка Назад -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: аватар + кнопка смены -->
                <RowDefinition Height="*"/>
                <!-- 1: свободное пространство -->
                <RowDefinition Height="Auto"/>
                <!-- 2: кнопка Назад -->
            </Grid.RowDefinitions>

            <!-- Аватар и кнопка смены фото (вложенная панель) -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border BorderBrush="#FF707070" BorderThickness="1" CornerRadius="5" 
                        Width="120" Height="120" Margin="0,0,0,10">
                    <Image Stretch="Uniform" 
                           Source="{Binding AvatarUrl, Converter={StaticResource ImageConverter}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Кнопка Назад внизу справа -->
            <Button Grid.Row="2" Command="{Binding BackCommand}" Content="Назад" 
                    Height="35" Width="80" FontSize="16" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
