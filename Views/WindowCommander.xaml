<Window x:Class="AISDisciplineDesc.WindowCommander"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AISDisciplineDesc"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Главное окно" Height="420" Width="900">
    <Window.Resources>
        <local:StringToImageSourceConverter x:Key="ImageConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Левая панель меню ===== -->
        <Border Grid.Column="0" Background="#FFF0F0F0" BorderBrush="#FFC0C0C0" BorderThickness="0,0,1,0">
            <StackPanel Margin="15,20,15,20">
                <Button Command="{Binding OpenOrdersCommand}" Content="Приказы"
                        Height="38" FontSize="15" Margin="0,0,0,10"/>
                <Button Command="{Binding OpenPersonnelCommand}" Content="Личные дела"
                        Height="38" FontSize="15" Margin="0,0,0,10"/>
                <Separator Margin="0,15,0,15"/>
                <Button Background="#b80707" Command="{Binding ExitCommand}" Content="Выйти"
                        Height="38" FontSize="15"/>
            </StackPanel>
        </Border>

        <!-- ===== Правая рабочая область ===== -->
        <Grid Grid.Column="1" Margin="25,15,20,24">
            <Grid.RowDefinitions>
                <!-- Шапка: аватар и имя -->
                <RowDefinition Height="Auto"/>
                <!-- Поля ввода -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопка Отправить -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка с картинкой и именем -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Image Height="50" Width="50" Stretch="UniformToFill" Source="{Binding AvatarUrl, Converter={StaticResource ImageConverter}}"/>
                <Label Name="LabelName" Content="{Binding UserName}" 
                       FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Label.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenProfileCommand}"/>
                    </Label.InputBindings>
                </Label>
            </StackPanel>

            <!-- Вертикальный список полей -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">

                <!-- Подразделение -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="Подразделение:" Width="110" VerticalAlignment="Center"/>
                    <ComboBox Name="DivisionComboBox" DisplayMemberPath="name"
                              ItemsSource="{Binding Divisions}"
                              SelectedItem="{Binding SelectedDivision}"
                              Width="190"/>
                </StackPanel>

                <!-- Наименование -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="Наименование:" Width="110" VerticalAlignment="Center"/>
                    <TextBox Name="NameOrder" Text="{Binding OrderName, UpdateSourceTrigger=PropertyChanged}"
                             Width="190" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Срок исполнения (без подсказки) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="Срок исполнения:" Width="110" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding DueDate}" 
                    DisplayDateStart="{Binding MinDueDate, Mode=OneWay}"
                    Width="130" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Файл PDF -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="Файл (PDF):" Width="110" VerticalAlignment="Center"/>
                    <TextBox Name="TxtPdfFile" Text="{Binding PdfFilePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" Width="230" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Command="{Binding SelectPdfCommand}" Content="Обзор"
                            Width="100" Height="29" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Описание -->
                <StackPanel Margin="0,5,0,0">
                    <Label Content="Описание:" Margin="0,0,0,3"/>
                    <RichTextBox x:Name="RichTextOrder" Height="44"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="0"/>
                </StackPanel>

            </StackPanel>

            <!-- Кнопка Отправить (по центру) -->
            <Button Grid.Row="2" Content="Отправить" Height="32" Width="150"
                    Command="{Binding CreateOrderCommand}"
                    CommandParameter="{Binding ElementName=RichTextOrder}"
                    HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
