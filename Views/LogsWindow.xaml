<Window x:Class="AISDisciplineDesc.Views.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал событий" 
        Height="600" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <DatePicker SelectedDate="{Binding FromDate}" Width="120" Margin="2" ToolTip="Дата от"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="120" Margin="2" ToolTip="Дата до"/>
                <ComboBox ItemsSource="{Binding LevelList}" SelectedItem="{Binding SelectedLevel}" Width="100" Margin="2" ToolTip="Уровень"/>
                <TextBox Text="{Binding UserLogin, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="2" ToolTip="Логин пользователя"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="2" ToolTip="Поиск по сообщению"/>
                <Button Command="{Binding ApplyFiltersCommand}" Content="Применить" Margin="2" Padding="10,2"/>
                <Button Background="#b80707" Command="{Binding ExitCommand}" Content="Выход" Margin="2" Padding="12,2"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False"
                  EnableRowVirtualization="True" IsReadOnly="True" AlternatingRowBackground="#F0F0F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата/время" Binding="{Binding timestamp, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="140"/>
                <DataGridTextColumn Header="Уровень" Binding="{Binding level}" Width="80"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding user_login}" Width="150"/>
                <DataGridTextColumn Header="Сообщение" Binding="{Binding message}" Width="*"/>
                <DataGridTextColumn Header="Компьютер" Binding="{Binding machine_name}" Width="120"/>
                <DataGridTextColumn Header="Версия" Binding="{Binding app_version}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель пагинации -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Command="{Binding PrevPageCommand}" Content="← Назад" Margin="5" Width="80"/>
            <TextBlock Text="Страница" VerticalAlignment="Center" Margin="5"/>
            <TextBlock Text="{Binding Page}" VerticalAlignment="Center" Margin="5"/>
            <TextBlock Text="из" VerticalAlignment="Center" Margin="5"/>
            <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5"/>
            <Button Command="{Binding NextPageCommand}" Content="Вперед →" Margin="5" Width="80"/>
            <TextBlock Text="Записей на странице:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <ComboBox ItemsSource="{Binding PageSizeList}" SelectedItem="{Binding PageSize}" Width="80" Margin="5"/>
            <TextBlock Text="Всего записей:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBlock Text="{Binding TotalCount}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        </StackPanel>
    </Grid>
</Window>
