<Window x:Class="AISDisciplineDesc.WindowOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AISDisciplineDesc"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Приказы" Height="500" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя строка: подразделение + кнопка Назад -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Label Content="Подразделение:" VerticalAlignment="Center"/>
                <ComboBox Name="DivCombobox" DisplayMemberPath="name"
                          ItemsSource="{Binding Divisions}"
                          SelectedItem="{Binding SelectedDivision}"
                          Width="184" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="2" Command="{Binding BackCommand}" Content="Назад"
                    Height="49" Width="90" FontSize="20"/>
        </Grid>

        <!-- Строка поиска -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Поиск:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" Margin="5,0" VerticalAlignment="Center"
                     ToolTip="Введите название или его часть"/>

            <Label Content="Дата с:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <DatePicker SelectedDate="{Binding SearchDateFrom}"
                        Width="110" Margin="5,0" VerticalAlignment="Center"/>

            <Label Content="по:" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding SearchDateTo}"
                        Width="110" Margin="5,0" VerticalAlignment="Center"/>

            <ComboBox ItemsSource="{Binding Statuses}"
                      SelectedItem="{Binding SelectedStatus}"
                      Width="130" Margin="10,0,0,0" VerticalAlignment="Center"
                      ToolTip="Фильтр по статусу"/>

            <Button Content="Очистить" Command="{Binding ClearFiltersCommand}"
                    Width="100" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- DataGrid с документами -->
        <DataGrid Grid.Row="2" Name="DataBaseGrid"
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding SelectedDocument}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Открыть" Command="{Binding OpenDocumentCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дата регистрации" Binding="{Binding DateDispatch, StringFormat=dd.MM.yyyy}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Срок исполнения" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Отметка о выполнении" Binding="{Binding Status}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
